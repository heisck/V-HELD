# Environment Mode
NODE_ENV=development
APP_ENV=development

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database Configuration (Development uses local LibSQL/sqld container; Production uses Turso)
DATABASE_URL=http://127.0.0.1:8080
DATABASE_AUTH_TOKEN=dev_token_libsql_local
# Turso Production Credentials (when APP_ENV=production)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cache / Rate Limiting (Development uses local Redis container; Production uses Upstash Redis)
REDIS_URL=redis://127.0.0.1:6379
# Upstash Redis Production Credentials (when APP_ENV=production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Media Storage Configuration (Development uses local server storage; Production uses Cloudinary)
STORAGE_DRIVER=local
# Cloudinary Production Credentials (when APP_ENV=production or STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Error Monitoring & Observability (Disabled in development mock mode)
ENABLE_SENTRY=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
